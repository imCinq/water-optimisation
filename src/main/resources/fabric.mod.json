{
	"schemaVersion": 1,
	"id": "wateroptimisation",
	"version": "${version}",
	"name": "Water Optimisation",
	"icon": "assets/wateroptimisation/icon.png",
	"description": "${target_description}",
	"authors": [
		"imCinq"
	],
	"contact": {
		"sources": "https://github.com/imCinq/water-optimisation"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.imcinq.wateroptimisation.WaterOptimisationClient"
		],
		"modmenu": [
			"io.github.imcinq.wateroptimisation.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "${client_mixin_config}",
			"environment": "client"
		}
	],
	"suggests": {
		"modmenu": "${modmenu_dependency}"
	},
	"depends": {
		"fabricloader": "${loader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": "${java_dependency}",
		"fabric-api": "*"
	}
}
